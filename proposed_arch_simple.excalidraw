  {
   "seed": 2120395275,
   "strokeStyle": "solid",
   "id": "foot",
   "strokeWidth": 1,
   "roughness": 1,
   "isDeleted": false,
   "fontSize": 14,
   "opacity": 100,
   "verticalAlign": "top",
   "updated": 1794035452637,
   "locked": false,
   "text": "Isolation: API/DB never touch sandboxes \u00b7 worker never runs task code \u00b7 runner sees only 3 secrets \u00b7 each task in its own microVM.\nResilience: if a worker dies its lease expires, another worker resumes from the last checkpoint; orphan sandboxes are reaped.\nTenancy: every query is scoped by organisation; admins see all org jobs, members only their own; foreign ids return 404.",
   "version": 36,
   "autoResize": true,
   "type": "text",
   "backgroundColor": "transparent",
   "roundness": null,
   "index": "ah",
   "containerId": null,
   "originalText": "Isolation: API/DB never touch sandboxes \u00b7 worker never runs task code \u00b7 runner sees only 3 secrets \u00b7 each task in its own microVM.\nResilience: if a worker dies its lease expires, another worker resumes from the last checkpoint; orphan sandboxes are reaped.\nTenancy: every query is scoped by organisation; admins see all org jobs, members only their own; foreign ids return 404.",
   "height": 52,
   "link": null,
