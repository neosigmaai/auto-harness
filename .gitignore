__pycache__/
*.pyc
*.pyo
.venv/
.venv-harness/
.env
.DS_Store
*.log

# editor droppings — not from the harness itself, but kept here so the
# file guard's `git ls-files --others` check doesn't false-positive on
# them when contributors run with these tools.
.idea/
.vscode/
*.swp
*.swo
*~

# agent working directory (runtime state, not committed)
workspace/
workspace_backups/
bird_data/

# local coding agent config
.claude/

# local experiment config (created by prepare.py from template)
experiment_config.yaml

# build/data artifacts
auto_harness.egg-info/
*.egg-info/

# harness_service: per-job candidate agent modules (kept on disk for debugging;
# named by agent_hash so they correlate with iterations.agent_hash in the DB)
agent/_candidates/

# harness_service: embedded dev Postgres data dir (scripts/dev_postgres.py)
.pgdata/

# tau2 data (auto-cloned by prepare.py, not committed)
tau2_data/

# BIRD-Interact-ADK (auto-cloned by prepare.py, not committed)
bird_interact_adk/
