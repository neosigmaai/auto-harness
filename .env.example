# LLM API keys — set whichever your agent_model needs
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Terminal-Bench sandbox provider (set one)
E2B_API_KEY=
DAYTONA_API_KEY=

# AgentBench OS
AGENTBENCH_DATA_DIR=/agentbench/data/os_interaction
AGENTBENCH_TASK_SPLIT=dev
AGENTBENCH_GATE_SPLIT=test
AGENTBENCH_MAX_WORKERS=5
