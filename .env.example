# LLM API keys — set whichever your agent_model needs
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Milestone 2+: Postgres for run state + job queue
# docker compose up -d postgres
DATABASE_URL=postgresql+psycopg://auto:auto@127.0.0.1:5432/auto_harness

# Optional worker identity
# WORKER_ID=worker-1

# Terminal-Bench sandbox provider (set one)
E2B_API_KEY=
DAYTONA_API_KEY=
# Modal (alternative to the token pair: run `modal token new` instead)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

