# LLM API keys — set whichever your agent_model needs
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Milestone 2+: Postgres for run state + job queue
# docker compose up -d postgres
DATABASE_URL=postgresql+psycopg://auto:auto@127.0.0.1:5432/auto_harness

# Milestone 3: execution backend (harbor = real Terminal-Bench; mock = fake results)
# EXECUTION_BACKEND=harbor
# EXECUTION_BACKEND=mock

# Optional worker identity
# WORKER_ID=worker-1

# Terminal-Bench sandbox provider (config/benchmark.yaml default is e2b).
# Override without editing YAML: ENV_PROVIDER=docker|e2b|daytona|modal
E2B_API_KEY=
# DAYTONA_API_KEY=
# Modal (alternative to the token pair: run `modal token new` instead)
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# ENV_PROVIDER=e2b

# --- Local smoke (Harbor + E2B) ---
# 1. Set OPENAI_API_KEY and E2B_API_KEY in this file
# 2. Install harbor: uv tool install harbor
# 3. docker compose up -d postgres   # queue only — task sandboxes use E2B, not local Docker
# 4. uvicorn api.main:app --port 8000
# 5. EXECUTION_BACKEND=harbor python -m worker.main
# 6. python test_client.py --mode run --task-ids fix-git --timeout 1800
