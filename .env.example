# LLM API keys — set whichever your agent_model needs
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Terminal-Bench sandbox provider (set one)
E2B_API_KEY=
DAYTONA_API_KEY=
# Modal (alternative to the token pair: run `modal token new` instead)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Agent Optimization Service only (does not use personal provider-key fields).
# NEOSIGMA_OPEN_API_KEY=company_key
# EXECUTOR=harbor
# OPTIMIZER=llm
# SANDBOX_PROVIDER=docker
# AGENT_MODEL=gpt-5.4-mini
# OPTIMIZER_MODEL=gpt-5.4-mini

