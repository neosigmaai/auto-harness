# LLM API keys — set whichever your agent_model needs
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Terminal-Bench sandbox provider (set one)
E2B_API_KEY=
DAYTONA_API_KEY=
# Modal (alternative to the token pair: run `modal token new` instead)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ── Optimization service (harness_service/) ──
# Postgres connection (async driver). Matches docker-compose.harness.yml defaults.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/harness
# Model that PROPOSES agent improvements in the M4 loop (uses OPENAI_API_KEY above).
OPENAI_MODEL=gpt-4o
# Default executor for jobs that don't specify one: "simulated" or "harbor".
DEFAULT_EXECUTOR=simulated

