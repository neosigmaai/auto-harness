FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir uv
COPY service/requirements.txt service/requirements.txt
RUN uv pip install --system --no-cache -r service/requirements.txt
# The compose image is the no-cost API/simulator demo. Real workers run on a
# Docker host with the separately pinned Harbor CLI; see service/requirements-harbor.txt.
COPY service/ service/
COPY scripts/ scripts/
COPY agent/templates/ agent/templates/
COPY test_client.py test_client.py
RUN mkdir -p runs
